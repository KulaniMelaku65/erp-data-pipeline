# Copy to .env and fill in. Never commit the real .env.
WAREHOUSE_URL=postgresql://erp:erp@localhost:5432/erp

# Business Central (SaaS). Register an app in Microsoft Entra ID with the
# "API.ReadWrite.All" (or read-only) Business Central application permission,
# then add it on the "Microsoft Entra Applications" page in BC.
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0/<tenant-id>/<environment>
BC_COMPANY_NAME=
BC_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
BC_CLIENT_ID=
BC_CLIENT_SECRET=

LOOKBACK_MINUTES=10
